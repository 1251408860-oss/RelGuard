  "API_semantics": {
    "crc32": "arbitrary uint32 prior crc; read eight-byte object up to length",
    "adler32": "fixed initial Adler seed 1; x ignored",
    "memmove": "original C units with within-object valid overlap and return pointer normalized to byte offset",
    "memcmp_sign": "original C comparison, normalized negative/zero/positive class; x ignored"
  },
  "static_miniz_export_header": "#ifndef MINIZ_EXPORT_H\n#define MINIZ_EXPORT_H\n#define MINIZ_EXPORT\n#define MINIZ_NO_EXPORT\n#define MINIZ_DEPRECATED __attribute__((deprecated))\n#define MINIZ_DEPRECATED_EXPORT MINIZ_EXPORT MINIZ_DEPRECATED\n#define MINIZ_DEPRECATED_NO_EXPORT MINIZ_NO_EXPORT MINIZ_DEPRECATED\n#endif\n",
  "disabled_miniz_features": [
    "archive APIs",
    "zlib stream APIs",
    "zlib-compatible names"
  ],
  "musl_configuration": "complete original memcpy/memmove/memcmp C units renamed to avoid host builtins; host-image standard headers; not a full musl-linked operating system",
  "basis": "origin plus 96 unit vectors for every configuration; no held-out answers used to fit",
  "source_admission": "all nine fields and auxiliary checks supported by both tools; native held-out agreement required; REFUTE applies to proposed contract, not a general API-equivalence verdict",
